<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F8F5">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.17"
        android:contentDescription="Latar pabrik"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_factory" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:contentDescription="Dekorasi hijau"
        android:scaleType="fitXY"
        android:src="@drawable/bg_login_top_arc"
        android:layout_gravity="top" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="0dp">

        <!-- Branding dibuat ringkas agar tetap terlihat tanpa scroll. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:contentDescription="Logo SI-PAMAN"
                android:scaleType="centerInside"
                android:src="@drawable/logo_sipaman" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:fontFamily="sans"
                android:text="SI-PAMAN"
                android:textColor="#0B5D2C"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:fontFamily="sans"
                android:text="Sistem Pantau Maintenance"
                android:textColor="#1F2937"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:layout_width="36dp"
                android:layout_height="2dp"
                android:layout_marginTop="5dp"
                android:background="#16803D" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="sans"
                android:gravity="center"
                android:text="Kelola, Pantau, dan Pastikan Perawatan Aset Tetap Optimal"
                android:textColor="#4B5563"
                android:textSize="11sp"
                android:maxLines="2" />
        </LinearLayout>

        <!-- Login card: kompak, mempertahankan semua ID yang dipakai Java. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#FEFFFE"
            app:cardCornerRadius="20dp"
            app:cardElevation="5dp"
            app:strokeColor="#E4F0E7"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="18dp"
                android:paddingEnd="16dp"
                android:paddingBottom="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans"
                    android:text="Selamat Datang"
                    android:textColor="#123023"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans"
                    android:text="Masuk untuk melanjutkan ke sistem SI-PAMAN"
                    android:textColor="#6B7280"
                    android:textSize="12sp"
                    android:maxLines="2" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Email"
                    app:boxBackgroundColor="#FFFFFF"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="#9FD3B0"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintTextColor="#6B7280"
                    app:startIconDrawable="@drawable/ic_email"
                    app:startIconTint="#16803D">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:fontFamily="sans"
                        android:inputType="textEmailAddress"
                        android:paddingEnd="10dp"
                        android:textColor="#111827"
                        android:textColorHint="#6B7280"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Password"
                    app:boxBackgroundColor="#FFFFFF"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="#9FD3B0"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:endIconMode="password_toggle"
                    app:endIconTint="#6B7280"
                    app:hintTextColor="#6B7280"
                    app:startIconDrawable="@drawable/ic_lock"
                    app:startIconTint="#16803D">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:fontFamily="sans"
                        android:inputType="textPassword"
                        android:paddingEnd="10dp"
                        android:textColor="#111827"
                        android:textColorHint="#6B7280"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans"
                    android:text="LOGIN"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="#16803D"
                    app:cornerRadius="24dp"
                    app:icon="@drawable/ic_login"
                    app:iconGravity="textEnd"
                    app:iconPadding="10dp"
                    app:iconTint="@android:color/white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSignup"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans"
                    android:text="Signup"
                    android:textAllCaps="false"
                    android:textColor="#6D28D9"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="#E9E1FF"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/ic_person"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconTint="#6D28D9" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Fitur dibuat satu baris yang rendah. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_login_feature_icon"
                    android:contentDescription="Planning maintenance"
                    android:padding="6dp"
                    android:src="@drawable/ic_calendar_dashboard"
                    app:tint="#16803D" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text="PLANNING&#10;MAINTENANCE"
                    android:textColor="#1F2937"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="38dp"
                android:background="#DCE8DF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_login_feature_icon"
                    android:contentDescription="Monitoring pekerjaan"
                    android:padding="6dp"
                    android:src="@drawable/ic_monitoring_chart"
                    app:tint="#16803D" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text="MONITORING&#10;PEKERJAAN"
                    android:textColor="#1F2937"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="38dp"
                android:background="#DCE8DF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_login_feature_icon"
                    android:contentDescription="Pengelolaan aset"
                    android:padding="6dp"
                    android:src="@drawable/ic_asset"
                    app:tint="#16803D" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text="PENGELOLAAN&#10;ASET"
                    android:textColor="#1F2937"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="38dp"
                android:background="#DCE8DF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_login_feature_icon"
                    android:contentDescription="Laporan real-time"
                    android:padding="6dp"
                    android:src="@drawable/ic_laporan"
                    app:tint="#16803D" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text="LAPORAN&#10;REAL-TIME"
                    android:textColor="#1F2937"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Ruang fleksibel mendorong footer ke bagian bawah layar. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Footer ringkas; tetap di bawah tanpa scroll. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_login_footer_wave">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:gravity="center"
                android:paddingBottom="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans"
                    android:text="SI-PAMAN Maintenance System"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans"
                    android:letterSpacing="0.06"
                    android:text="PT. SEGER AGRO NUSANTARA"
                    android:textColor="#FFFFFF"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="sans"
                    android:text="v1.0.0"
                    android:textColor="#D1FAE5"
                    android:textSize="8sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
